# ============================================
# Explore Kimberley - Example Environment File
# ============================================
# Copy this file to `.env` and fill in real values.
# NEVER put real secrets here.

# Optional PostgreSQL connection string; leave blank to use local SQLite.
DATABASE_URL=

# These are development-safe values. Use HTTPS and secure cookies when hosted.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
EMAIL_VERIFICATION_MAX_AGE=86400

SECRET_KEY=replace-me-with-a-real-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
SITE_URL=http://127.0.0.1:8000

# Used only for administrator invitation emails; other platform emails above
# continue to use the shared Explore Kimberley mailbox.
OWNER_EMAIL_HOST=smtp.gmail.com
OWNER_EMAIL_PORT=587
OWNER_EMAIL_USE_TLS=True
OWNER_EMAIL_HOST_USER=owner-email@gmail.com
OWNER_EMAIL_HOST_PASSWORD=your-owner-16-char-app-password